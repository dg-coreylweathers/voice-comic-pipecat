# Required for the voice pipeline (not for unit tests or the HTTP-only paths)
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Signs browser session tokens; random per boot if unset (tokens then die on restart)
SESSION_SECRET=

# Optional
PORT=8080
DATA_DIR=./data
AUDIO_TTL_HOURS=24
# Booth mode for public venues: WARNING-level logs only, redaction defaults on, no audio stored,
# saved strips trimmed and deleted after STRIP_TTL_HOURS. The toolbar toggle (b) chooses it per strip.
BOOTH_MODE=
STRIP_TTL_HOURS=2
# Themes tally label, e.g. reinvent-2026; export with GET /api/themes.csv
EVENT_NAME=default
# Overrides the base persona prompt (modes still append their own text)
AGENT_PROMPT=
# 1 = send mip_opt_out=true on every Deepgram service (model-improvement program opt-out)
MIP_OPT_OUT=
# Concurrent bots per machine
MAX_SESSIONS=4
# Comma-separated Origins allowed on WS /api/agent; empty = any origin (Pipecat default)
ALLOWED_ORIGINS=
